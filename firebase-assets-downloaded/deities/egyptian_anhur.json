    "worshipPractices": [
      {
        "name": "Offerings",
        "description": "Offerings of food, drink, and incense were made to Anhur in his temples. Animal sacrifices, particularly of gazelles and other hunted animals, were also offered to honor his role as a hunter and warrior. These offerings aimed to appease the god and ensure his continued favor."
      },
      {
        "name": "Statues and Shrines",
        "description": "Statues and shrines dedicated to Anhur were erected in temples and sacred spaces. These served as focal points for worship and allowed devotees to connect with the god on a personal level. Priests conducted rituals and ceremonies before these images, invoking Anhur's presence and blessings."
      }
    ],
    "festivals": [
      {
        "name": "Festival of Anhur",
        "timing": "Specific dates varied by region, but generally celebrated annually",
        "description": "The Festival of Anhur involved processions, feasts, and ritualistic combat displays showcasing martial prowess. These events celebrated Anhur's strength and valor, reinforcing his role as a protector and warrior. The festivals were often synchronized with agricultural cycles or military victories."
      }
    ],
    "modernLegacy": "While not actively worshipped today, Anhur's image and stories persist in modern Egyptology studies and popular culture. He represents the strength and courage of the Egyptian warrior spirit, occasionally appearing in books, games, and other media related to ancient Egypt."
  },
  "keyMyths": [
    {
      "title": "The Return of Tefnut",
      "description": "Anhur is credited with bringing Tefnut back to Egypt, ending a drought and restoring balance to the land. His role highlights his ability to resolve conflicts and bring prosperity.",
      "source": "Various Ancient Egyptian Texts"
    },
    {
      "title": "Anhur's Role in Warfare",
      "description": "As a war god, Anhur protected the pharaoh and the Egyptian army, ensuring victory in battle against their enemies. His fierce nature and skill with weapons made him a formidable deity.",
      "source": "Ancient Egyptian Military Texts"
    },
    {
      "title": "Anhur and Mekhit",
      "description": "Anhur's consort, Mekhit, a lioness goddess, represents his control over the wild and untamed aspects of nature. Together, they symbolize power and protection.",
      "source": "Temple Inscriptions at Thinis"
    }
  ],
