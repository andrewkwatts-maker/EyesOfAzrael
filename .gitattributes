# Generated files are byte-compared by CI (npm run build:css:check), so their
# line endings must not depend on which platform checked them out.
#
# core.autocrlf=true on Windows would hand back CRLF while the generator emits
# LF, and the check would fail on a bundle that is perfectly up to date.
css/bundle.css          text eol=lf
css/bundle.manifest.json text eol=lf
